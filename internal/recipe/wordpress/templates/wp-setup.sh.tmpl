#!/usr/bin/env bash
# Managed by stamper: regenerated by `stamper config`, manual edits are overwritten.
# Runs after every `lando start` and on demand via `lando wp-setup [--force]`.
# Idempotent: exits immediately when nothing changed since the last run.
set -uo pipefail

STAMP={{sh .Hash}}
WEBROOT=/app/{{if ne .Webroot "."}}{{.Webroot}}{{end}}
MARKER=/app/.lando/stamper/setup.applied
URL={{sh .SiteURL}}

say()  { printf '\033[35m[stamper]\033[0m %s\n' "$*"; }
warn() { printf '\033[33m[stamper]\033[0m %s\n' "$*" >&2; }

mkdir -p "$WEBROOT" && cd "$WEBROOT" || exit 1

if [[ "${1:-}" != "--force" && -f "$MARKER" && "$(cat "$MARKER")" == "$STAMP" ]] && wp core is-installed >/dev/null 2>&1; then
  exit 0
fi

# Wait for the database (fresh MySQL/MariaDB containers need a few seconds).
for _ in $(seq 1 45); do
  php -r 'exit(@mysqli_connect("database","wordpress","wordpress","wordpress") ? 0 : 1);' 2>/dev/null && break
  sleep 2
done
{{- if .Install}}

if [[ ! -f wp-includes/version.php ]]; then
  say "Downloading WordPress {{v .Values "wp-version"}} ({{v .Values "wp-locale"}})"
  wp core download --version={{sh (v .Values "wp-version")}} --locale={{sh (v .Values "wp-locale")}} || { warn "core download failed"; exit 1; }
fi

if [[ ! -f wp-config.php && ! -f ../wp-config.php ]]; then
  say "Creating wp-config.php"
  wp config create --dbname=wordpress --dbuser=wordpress --dbpass=wordpress --dbhost=database --skip-check || exit 1
fi
{{- end}}

# wp config edits only parse wp-config.php (no WordPress bootstrap), so they
# run first: a stale object-cache drop-in must never break the checks below.
if wp config path >/dev/null 2>&1; then
  say "Applying local configuration"
  cfg()   { wp config set "$1" "$2" --type=constant --quiet "${@:3}"; }
  uncfg() { wp config has "$1" 2>/dev/null && wp config delete "$1" --quiet; }

  cfg WP_ENVIRONMENT_TYPE local
  cfg WP_DEBUG true --raw
  cfg WP_DEBUG_LOG true --raw
  cfg WP_DEBUG_DISPLAY false --raw
  cfg SCRIPT_DEBUG true --raw
  cfg WP_CACHE_KEY_SALT {{sh (printf "%s:" .URL)}}
  {{- if or (eq .CacheKind "redis") (eq .CacheKind "valkey")}}
  cfg WP_REDIS_HOST {{.CacheHost}}
  cfg WP_REDIS_PORT {{.CachePort}} --raw
  {{- else}}
  uncfg WP_REDIS_HOST
  uncfg WP_REDIS_PORT
  {{- end}}
fi
{{- if not (or (eq .CacheKind "redis") (eq .CacheKind "valkey"))}}

# No Redis/Valkey service: remove a redis-cache drop-in before it can stall WordPress.
if grep -qs "Redis Object Cache" wp-content/object-cache.php; then
  say "Removing the Redis object-cache drop-in"
  rm -f wp-content/object-cache.php
fi
{{- end}}
{{- if .Install}}

if ! wp core is-installed >/dev/null 2>&1; then
  say "Installing WordPress at $URL"
  {{- if .Multisite}}
  wp core multisite-install --url="$URL" --title={{sh (v .Values "name")}} \
    --admin_user={{sh (v .Values "admin-user")}} --admin_password={{sh (v .Values "admin-password")}} \
    --admin_email={{sh (v .Values "admin-email")}} --skip-email{{if .Subdomains}} --subdomains{{end}} || exit 1
  {{- else}}
  wp core install --url="$URL" --title={{sh (v .Values "name")}} \
    --admin_user={{sh (v .Values "admin-user")}} --admin_password={{sh (v .Values "admin-password")}} \
    --admin_email={{sh (v .Values "admin-email")}} --skip-email || exit 1
  {{- end}}
  wp rewrite structure '/%postname%/' --quiet
fi
{{- end}}

if ! wp core is-installed >/dev/null 2>&1; then
  say "WordPress is not installed yet; skipping configuration."
  exit 0
fi
{{- if .CachePlugin}}

NETWORK={{if .Multisite}}--network{{end}}
wp plugin is-installed redis-cache || wp plugin install redis-cache --quiet
wp plugin activate redis-cache $NETWORK --quiet
wp redis enable --force >/dev/null 2>&1 || warn "could not enable the Redis object-cache drop-in"
{{- else if not (or (eq .CacheKind "redis") (eq .CacheKind "valkey"))}}

if wp plugin is-active redis-cache >/dev/null 2>&1 || wp plugin is-active redis-cache --network >/dev/null 2>&1; then
  wp plugin deactivate redis-cache {{if .Multisite}}--network {{end}}--quiet || true
fi
{{- end}}
{{- if ne .Webserver "nginx"}}

if [[ ! -f .htaccess ]]; then
  say "Writing .htaccess"
  cat > .htaccess <<'HTACCESS'
# BEGIN WordPress
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
RewriteBase /
RewriteRule ^index\.php$ - [L]
{{- if and .Multisite .Subdomains}}
RewriteRule ^wp-admin$ wp-admin/ [R=301,L]
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]
RewriteRule ^(wp-(content|admin|includes).*) $1 [L]
RewriteRule ^(.*\.php)$ $1 [L]
RewriteRule . index.php [L]
{{- else if .Multisite}}
RewriteRule ^([_0-9a-zA-Z-]+/)?wp-admin$ $1wp-admin/ [R=301,L]
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]
RewriteRule ^([_0-9a-zA-Z-]+/)?(wp-(content|admin|includes).*) $2 [L]
RewriteRule ^([_0-9a-zA-Z-]+/)?(.*\.php)$ $2 [L]
RewriteRule . index.php [L]
{{- else}}
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . /index.php [L]
{{- end}}
</IfModule>
# END WordPress
HTACCESS
fi
{{- end}}

wp cache flush --quiet >/dev/null 2>&1 || true
echo "$STAMP" > "$MARKER"
say "Ready: $URL"

; Managed by stamper: regenerated by `stamper config`, manual edits are overwritten.
; Put personal overrides in a separate file and reference it from .lando.local.yml.
[PHP]
memory_limit = {{v .Values "memory-limit"}}
upload_max_filesize = {{v .Values "upload-max"}}
post_max_size = {{v .Values "upload-max"}}
max_execution_time = 300
max_input_time = 300
max_input_vars = 10000
realpath_cache_size = 4096K
realpath_cache_ttl = 600
output_buffering = 4096
expose_php = Off
allow_url_fopen = On

; Errors: loud locally, logged to the container's stderr.
error_reporting = E_ALL
display_errors = On
display_startup_errors = On
log_errors = On
html_errors = Off
{{- if eq (v .Values "mail") "none"}}
sendmail_path = /bin/true
{{- end}}

[Date]
date.timezone = UTC

[opcache]
{{- if .OpcacheOn}}
opcache.enable = 1
opcache.enable_cli = 0
opcache.memory_consumption = 256
opcache.interned_strings_buffer = 32
opcache.max_accelerated_files = 30000
opcache.validate_timestamps = {{if .OpcacheValidate}}1{{else}}0{{end}}
opcache.revalidate_freq = {{.OpcacheFreq}}
opcache.save_comments = 1
{{- if .JIT}}
opcache.jit = tracing
opcache.jit_buffer_size = 128M
{{- else}}
opcache.jit_buffer_size = 0
{{- end}}
{{- else}}
opcache.enable = 0
opcache.enable_cli = 0
{{- end}}

[apcu]
apc.enabled = 1
apc.shm_size = 128M
apc.enable_cli = {{if eq .CacheKind "apcu"}}1{{else}}0{{end}}
{{- if ne .Webserver "openlitespeed"}}

[xdebug]
; XDEBUG_MODE comes from the `xdebug:` key in .lando.yml.
xdebug.mode = ${XDEBUG_MODE}
xdebug.start_with_request = trigger
xdebug.max_nesting_level = 512
xdebug.output_dir = /tmp
{{- end}}
